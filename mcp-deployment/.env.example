# =============================================================================
# .env.example — runtime env + compose interpolation for the standalone
# SharePoint MCP stack. Copied to ./.env (chmod 600) by ./setup.sh — never
# commit ./.env.
#
# Graph credentials come from the Entra ID (Azure AD) app registration used
# for SharePoint access. The registration needs application permissions
# (admin-consented, read-only deployment):
#   Sites.Read.All, Files.Read.All, User.Read.All
#
# NEVER copy the MCP-Server repo's own .env here — generate fresh credentials
# per deployment.
# =============================================================================

# ── Graph API credentials ────────────────────────────────────────────────────
# Entra ID tenant (Directory ID)
TENANT_ID=

# App registration (Application/Client ID) + client secret VALUE (not the ID)
CLIENT_ID=
CLIENT_SECRET=

# NOTE (multi-site stack): do NOT set SITE_URL or SITE_N_URL/SITE_N_NAME in
# this shared file — this file is loaded by EVERY container, and each
# container's own site binding lives in envs/mcp-<site>.env (loaded after
# this file, so it wins). A SITE_URL here would silently leak into any
# container whose envs/ file went missing.

# Verbose server logging (true/false)
DEBUG=false

# ── Access control ───────────────────────────────────────────────────────────
# Host-header allow-list (DNS-rebinding guard): requests whose Host header is
# not listed get HTTP 421. MUST include the VM's private IP, because that is
# what the app container puts in the Host header when it connects to
# http://<vm-private-ip>:8000/mcp. ./setup.sh detects the IP and writes this
# line — re-run ./setup.sh if the VM's private IP ever changes.
MCP_ALLOWED_HOSTS=192.168.29.245:*,localhost:*,127.0.0.1:*

# ── Image tag (compose interpolation) ────────────────────────────────────────
# Tag of ghcr.io/lpanigrahi/ms-sharepoint-mcp to run (image ref is fixed in
# docker-compose.yml). CI publishes :latest + :sha-<commit> on merges to main
# and :X.Y.Z / :X.Y on vX.Y.Z tags. Pin :X.Y.Z or :sha-<commit> for
# deterministic deploys.
#MCP_IMAGE_TAG=latest

# ── Host bind address (compose interpolation) ────────────────────────────────
# Address the per-site host ports (8001-8011, fixed in docker-compose.yml)
# bind to. On Azure the NIC only carries the private IP, so 0.0.0.0 ≈
# private-IP binding; keep 8001-8011 CLOSED in the Azure NSG (default-deny)
# so they are never internet-facing.
MCP_BIND_IP=0.0.0.0

# ---------------------------------------------------------------------------
# Microsoft Search API region — REQUIRED for app-only tokens on /search/query.
# Set to the tenant's data region: NAM, EUR, APC, IND, ...
# ---------------------------------------------------------------------------
SEARCH_REGION=IND

# ---------------------------------------------------------------------------
# Startup diagnostics (off by default). When True, token acquisition also
# probes the site AND creates/deletes a test folder — mutates SharePoint.
# ---------------------------------------------------------------------------
AUTH_STARTUP_CHECKS=False

# ---------------------------------------------------------------------------
# Size of the dedicated thread pool for Microsoft Graph I/O (downloads,
# uploads, throttle retries). Separate from auth so a saturated Graph pool
# can never stall token refresh.
# ---------------------------------------------------------------------------
GRAPH_IO_MAX_WORKERS=32

# --- Download size limits (megabytes) --------------------------------------
# How large a document search_documents will fetch in order to read it.
# Raise to include large PDFs; lower on a memory-constrained host. Fractional
# values are allowed (e.g. 0.5). An unparseable or out-of-range value is
# ignored with a warning and the default is used — a typo here must not stop
# the container booting.
#
# MAX_DOCUMENT_MB=32
#
# Tighter ceiling for spreadsheets, which are read through pandas and expand
# many times over in memory. Clamped to never exceed MAX_DOCUMENT_MB.
# MAX_SPREADSHEET_MB=5
#
# Above this size a download streams to a temp file instead of being held in
# RAM. Lower it if the container is memory-constrained.
# STREAM_TO_DISK_MB=10

# --- Page-image rendering (integers) ---------------------------------------
# get_document_page_image renders scanned/vector PDFs and image files as
# images for multimodal clients. Unparseable or out-of-range values warn and
# fall back to the default.
#
# IMAGE_MAX_PAGES_PER_CALL=4
# IMAGE_MAX_EDGE_PX=1568
# IMAGE_JPEG_QUALITY=78
