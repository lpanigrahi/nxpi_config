# All eleven SharePoint sites, in one container.
#
# The eleven per-site files beside this one bind ONE site each, because the
# site used to be baked into the container. It no longer has to be: identity
# arrives per request, so one process can serve every site.
#
# Shared Graph credentials and MCP_ALLOWED_HOSTS come from ../.env, which is
# listed first in the service's env_file so values here win on any overlap.
# No secrets in this file — it is tracked in git.
#
# NAMES ARE THE PUBLIC INTERFACE. `list_available_sites` returns them and the
# model passes them back as the `site_name` argument.
#
# THEY DO CHANGE, and it is worth being clear about how. Each of the eleven
# containers sets only `SITE_URL`, which `config/settings.py` registers as the
# single entry `{"Default": url}` — so today every container reports exactly
# one site, all eleven of them called "Default". `site_name` has never
# disambiguated anything, because the SERVER was the site: the client picked a
# department by choosing which of eleven MCP endpoints to call.
#
# One container inverts that. `list_available_sites` now returns eleven
# distinct names and `site_name` becomes load-bearing for the first time. The
# names below are the slugs the per-container Docker labels already used, so
# they match what an operator sees in `docker inspect` and in the site URLs —
# but a client that hard-coded `site_name="Default"` will need updating, and a
# model that learned the eleven-endpoint shape will see one endpoint with
# eleven sites instead.
#
# GAPS ARE SAFE. The registry scans a fixed range rather than stopping at the
# first missing index, so commenting out SITE_4 below does not discard 5
# through 11. That was not always true — see the test in
# tests/test_site_registry_consistency.py.

SITE_1_URL=https://nbcbearingsrj.sharepoint.com/sites/researchanddevelopment
SITE_1_NAME=researchanddevelopment

SITE_2_URL=https://nbcbearingsrj.sharepoint.com/sites/manufacturing
SITE_2_NAME=manufacturing

SITE_3_URL=https://nbcbearingsrj.sharepoint.com/sites/qualityassurance
SITE_3_NAME=qualityassurance

SITE_4_URL=https://nbcbearingsrj.sharepoint.com/sites/salesmarketing
SITE_4_NAME=salesmarketing

SITE_5_URL=https://nbcbearingsrj.sharepoint.com/sites/hr
SITE_5_NAME=hr

SITE_6_URL=https://nbcbearingsrj.sharepoint.com/sites/Finance
SITE_6_NAME=Finance

SITE_7_URL=https://nbcbearingsrj.sharepoint.com/sites/centrallogistics-stores
SITE_7_NAME=centrallogistics-stores

SITE_8_URL=https://nbcbearingsrj.sharepoint.com/sites/GeneralManagement
SITE_8_NAME=GeneralManagement

SITE_9_URL=https://nbcbearingsrj.sharepoint.com/sites/ir
SITE_9_NAME=ir

SITE_10_URL=https://nbcbearingsrj.sharepoint.com/sites/SCM
SITE_10_NAME=SCM

SITE_11_URL=https://nbcbearingsrj.sharepoint.com/sites/nei-amsted
SITE_11_NAME=nei-amsted
