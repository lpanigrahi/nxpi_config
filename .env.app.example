# =============================================================================
# .env.app — runtime env_file for the `app` container (standalone Azure deploy).
#
# Copy to `.env.app` (never commit it) and fill in. This file supplies values
# the compose `environment:` block does NOT pass through — chiefly the LLM
# provider key(s). DB / Redis / auth-secret come from ./secrets/*; the public
# URL and image ref come from ./.env (Compose interpolation).
#
#   cp .env.app.example .env.app   # then edit  (./install.sh does this for you)
# =============================================================================

# --- LLM providers (set AT LEAST ONE; the app is unusable without one) --------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# Web search tool (Exa). Without a key the built-in web-search/web-content
# tools are unavailable in chat.
# EXA_API_KEY=

# AWS Bedrock (optional provider — activates when the token is set).
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_BEDROCK_REGION=us-east-1

# Google Vertex AI (optional provider — activates when the project is set).
# GOOGLE_VERTEX_CREDENTIALS is a path/JSON for a service account; inside the
# container prefer inline JSON (there is no mounted key file).
# GOOGLE_VERTEX_PROJECT=
# GOOGLE_VERTEX_LOCATION=us-central1
# GOOGLE_VERTEX_CREDENTIALS=

# Azure OpenAI (if using Azure-hosted models instead of/alongside the above).
# AZURE_OPENAI_DEPLOYMENTS is REQUIRED for any Azure models to appear (comma-
# separated deployment names from Azure AI Foundry).
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENTS=gpt-4o,gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2025-01-01-preview        # optional

# --- File storage (optional) --------------------------------------------------
# Default is local disk on the `uploads-data` volume. To use Azure Blob
# instead, uncomment FILE_STORAGE_TYPE + the container, then EITHER the
# connection string OR account name+key (not both). NOTE: the blob container
# must already exist (the app never creates it) and its CORS must allow the
# browser origin — see the app repo's docs/deployment/azure-vm.md §C.4b.
# FILE_STORAGE_TYPE=azure
# FILE_STORAGE_AZURE_CONTAINER=neogen-uploads
#   Option A — connection string:
# FILE_STORAGE_AZURE_CONNECTION_STRING=
#   Option B — account name + key (enables direct client SAS uploads):
# FILE_STORAGE_AZURE_ACCOUNT_NAME=
# FILE_STORAGE_AZURE_ACCOUNT_KEY=
#   Optional (either option):
# FILE_STORAGE_AZURE_PUBLIC_BASE_URL=                  # CDN / custom domain
# FILE_STORAGE_AZURE_ENDPOINT_SUFFIX=core.windows.net  # for sovereign clouds

# --- Cookies / ingress mode ----------------------------------------------------
# IP-only mode (plain HTTP on the VM IP) REQUIRES this: NODE_ENV=production
# forces Secure cookies by default, and browsers refuse to store Secure
# cookies over http:// — sign-in silently loops. Explicit false disables the
# force. Domain mode (https://): leave unset (Secure stays on — do NOT set
# false).
# BETTER_AUTH_COOKIE_SECURE=false
# Client-IP resolution behind proxies (rate limits + audit records key off it).
# The app takes the rightmost X-Forwarded-For token minus this many ADDITIONAL
# trusted hops. This stack's own Caddy is the directly-connected proxy and is
# already accounted for — leave at the default 0 unless you chain ANOTHER
# trusted proxy in front (Azure Front Door / App Gateway ⇒ 1 per extra hop).
# Setting it too high lets clients spoof their IP via a forged XFF header.
# TRUSTED_PROXY_HOPS=0

# --- Sign-up / secrets hardening (recommended on a public VM) -----------------
# Self-serve sign-up is INVITE-ONLY by default (blank = closed), for
# email/password and for every OAuth/SSO provider alike. Admins provision users
# first; an unprovisioned OAuth sign-in is refused at the callback.
# The line below is redundant with the default and is kept explicit so that
# uncommenting anything in this block stays protective. To OPEN self-serve
# registration to anyone who can reach the VM, set DISABLE_SIGN_UP=false —
# deliberately not written here as a ready-to-uncomment line.
# DISABLE_SIGN_UP=true
# Disable email/password sign-in entirely (OAuth/SSO-only deployments).
# DISABLE_EMAIL_SIGN_IN=true
# Dedicated AES key for the connector-credential vault (integrations,
# per-org provider keys). WITHOUT it, encryption silently falls back to a key
# derived from BETTER_AUTH_SECRET — rotating that secret then breaks stored
# credentials. Generate once (openssl rand -hex 32) and never change casually.
# SECRETS_ENCRYPTION_KEY=
# Rotation-capable form (supersedes the single key when set): a JSON map of
# key-id → key plus the id encryption should use for NEW writes. Old entries
# stay decryptable by their recorded key id, enabling zero-downtime rotation.
# SECRETS_ENCRYPTION_KEYS={"k1":"<hex-32>","k2":"<hex-32>"}
# SECRETS_ENCRYPTION_ACTIVE_KEY_ID=k2
# Dedicated HMAC key for the tamper-evident admin-audit hash chain (db ≥
# 1.9.0). Falls back to BETTER_AUTH_SECRET — set a dedicated key BEFORE the
# first audit row so rotating the auth secret never breaks chain verification.
# Changing it later makes previously signed rows fail verification.
# AUDIT_SIGNING_KEY=
# Outbound-URL guard (SSRF): connectors, webhooks and MCP servers on PRIVATE
# (RFC1918/loopback) addresses are REFUSED by default. Opt in when your
# integrations legitimately live on the VM's private network (e.g. the
# SharePoint MCP sidecars on the VM itself, an on-prem Jira). BREAKING change
# for deployments that relied on the old always-allow behavior.
# ALLOW_PRIVATE_URLS=true
# Skill signing/attestation (skill governance): Ed25519 keys for signing
# published skills and verifying attestations. Without them the attestation
# surface is inert. PUBLIC_KEYS is a JSON map of key-id → public key.
# SKILL_SIGNING_PRIVATE_KEY=
# SKILL_SIGNING_KEY_ID=
# SKILL_SIGNING_PUBLIC_KEYS=

# --- Boot fail-closed modes (advanced; defaults are production-correct) -------
# DB-role preflight: the app REFUSES a POSTGRES_URL whose role is SUPERUSER or
# BYPASSRLS (RLS would be silently inert). Default: enforce in production,
# warn otherwise. This package's two-role provisioning (neo_gen app role)
# already satisfies it — do not weaken without understanding the RLS posture.
# DB_ROLE_PREFLIGHT_MODE=enforce
# Tenant context enforcement: `enforce` makes org-scoped DB access fail closed
# when no tenant context is established (instead of warn-and-continue).
# TENANT_ALS_MODE=enforce

# --- OAuth / SSO (optional) ---------------------------------------------------
# If you enable any OAuth provider, set sameSite=lax — the default "strict"
# drops the session cookie on the cross-site provider callback, breaking OAuth
# login. (Email/password login works fine on the default.)
# BETTER_AUTH_COOKIE_SAMESITE=lax
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Lock Microsoft sign-in to one Entra tenant (default: multi-tenant "common").
# MICROSOFT_TENANT_ID=

# --- Browser automation (optional; OFF by default) ---------------------------
# To enable: (1) set BROWSER_TOKEN *and* BROWSER_WS_ENDPOINT in ./.env — NOT
# here: the compose file interpolates BROWSER_WS_ENDPOINT from ./.env into the
# app's `environment:`, which OVERRIDES anything set in this env_file — then
# (2) uncomment ALLOW_BROWSER_AUTOMATION below, and (3) start the sidecar:
# `./compose.sh --profile browser up -d`. The app image ships no Chromium, so
# the sidecar endpoint is REQUIRED in production (in-process launch is dev-only).
# ALLOW_BROWSER_AUTOMATION=true
# Domain policy for the browser tool. ALLOWED empty = all domains; DENIED
# defaults to localhost,127.0.0.1 (keep it — the tool could otherwise reach
# the app's own backend network). Comma-separated hostnames.
# BROWSER_ALLOWED_DOMAINS=
# BROWSER_DENIED_DOMAINS=localhost,127.0.0.1

# --- Server-side code execution (optional; OFF by default) --------------------
# Enables the built-in bash/python execution tool. Commands run INSIDE the app
# container (uid 1001, cap_drop ALL) — still, only enable if your users are
# trusted; anything they run can reach the backend network (postgres, redis).
# ALLOW_BASH_EXECUTION=true
# Allow-list of commands the bash tool may run (comma-separated). NOTE: the
# app's built-in default no longer includes `curl` (exfiltration surface) —
# add it back here only deliberately.
# BASH_ALLOWED_COMMANDS=

# --- Rate limits (per user; defaults are LOW for a shared VM) ------------------
# Sign-in attempts per 15 min (default 10, fail-closed).
# AUTH_RATE_LIMIT_PER_15_MINUTES=10
# Chat messages per minute (default 20) / other API calls per minute (default 30).
# CHAT_RATE_LIMIT_PER_MINUTE=20
# API_RATE_LIMIT_PER_MINUTE=30

# --- MCP tuning (matters if you run the SharePoint MCP servers) ---------------
# The sharepoint-mcp package runs one container per site (ports 8001-8011),
# registered in the MCP Configuration UI as http://<vm-private-ip>:<port>/mcp.
# All of them share ONE Azure AD app registration, so they share ONE Microsoft
# Graph tenant quota — and Graph rate-limits /search/query hard.
#
# Concurrency against such a server is self-defeating. Measured on the live
# tenant with `search_documents`: 1 call 4.6s · 2 calls 37.7s · 4 calls 73s ·
# 8 calls 180s with FIVE breaching the timeout — while the SAME 8 serialized
# took 72s with a 26s worst case and zero failures. Serial is both faster and
# correct, because each throttled call sleeps through a `Retry-After: 30`.
#
# Max tool calls in flight against ONE MCP server (default 4; 0 = unlimited).
# MCP_SERVER_MAX_CONCURRENCY=
#
# Per-server override, JSON keyed by server id or name (id wins). Set 1 for
# every SharePoint site server you register — add the others as you add them.
# MCP_SERVER_CONCURRENCY_OVERRIDES={"MS-SP-RD":1}
#
# How long a call may wait for a free slot before failing "server is busy"
# (default 300000). The per-call timeout starts AFTER the slot is acquired, so
# queueing never eats a call's own budget.
# MCP_SERVER_QUEUE_TIMEOUT_MS=
#
# Absolute ceiling for ONE MCP request (ms). Raise it ABOVE a server's own retry
# budget: the SharePoint server backs off up to 5 x 30s when Graph throttles the
# tenant (~150s), which the 120s default cut off before it could ever succeed.
# MCP_MAX_TOTAL_TIMEOUT=240000
#
# Per-tool-call timeout (ms, default 120000).
# MCP_TOOL_CALL_TIMEOUT=

# --- LLM/RAG caching (Redis-backed — live on this stack; ALL default OFF) -----
# Response cache: replays identical low-temperature completions.
# CACHE_RESPONSE_ENABLED=1
# CACHE_RESPONSE_TTL_MS=
# CACHE_RESPONSE_MAX_TEMPERATURE=
# Encrypt cached responses at rest in Redis (uses the secrets encryption key).
# CACHE_RESPONSE_ENCRYPT=1
# Semantic cache: serves cached answers for near-identical prompts (embedding
# similarity ≥ threshold).
# CACHE_SEMANTIC_ENABLED=1
# CACHE_SEMANTIC_THRESHOLD=
# Retrieval (RAG chunk) cache + provider prompt caching + per-tool TTLs.
# CACHE_RETRIEVAL_ENABLED=1
# CACHE_RETRIEVAL_TTL_MS=
# CACHE_PROVIDER_PROMPT_ENABLED=1
# CACHE_TOOL_TTL_MS_OVERRIDES=

# --- Capacity & tuning (defaults suit a single 16 GB VM) ----------------------
# Postgres pool ceilings for the app / privileged (background) pools.
# DB_POOL_MAX=
# DB_PRIVILEGED_POOL_MAX=
# BullMQ worker concurrency (workflow runs; integration sync/event fan-out).
# WORKFLOW_WORKER_CONCURRENCY=
# INTEGRATION_SYNC_CONCURRENCY=
# INTEGRATION_EVENT_CONCURRENCY=
# Cron scheduler ceiling across all jobs.
# CRON_MAX_CONCURRENT_JOBS=

# --- Other optional runtime config -------------------------------------------
# Built-in marketplace skills self-seed at app boot (idempotent; owned by the
# first admin). Uncomment to disable — e.g. for a curated marketplace where
# platform skills are managed manually.
# SEED_BUILTIN_SKILLS=false
# CRON_SECRET=
# EMBEDDING_PROVIDER=openai
# Multi-model embedding store (default OFF). Required for the `azure-foundry`
# embedding provider: with it off, Organizations > Knowledge Bases > Embedding
# provider never offers azure-foundry, so its Endpoint / Deployment / API
# version / API key form is absent and the Vector-size selector stays locked.
# Read-time rollout is a SEPARATE flag — see
# docs/knowledge/azure-foundry-embeddings.md before enabling RAG_MULTI_MODEL_STORE_READ.
# RAG_MULTI_MODEL_STORE_WRITE=1
# RAG_MULTI_MODEL_STORE_READ=1

# RAG limits (per user) — unset = unlimited size/count; TTL default 30 days.
# RAG_MAX_FILE_SIZE_MB=
# RAG_MAX_DOCUMENTS_PER_USER=
# RAG_TTL_DAYS=30
# RAG ingestion tuning: embedding-request batching by TOKENS (providers cap
# tokens per request, not chunk count), parallelism, and chunk-size caps.
# RAG_EMBED_MAX_TOKENS_PER_REQUEST=
# RAG_EMBED_MAX_CONCURRENCY=
# RAG_MAX_DOCUMENT_CHUNK_CHARS=
# Embedding vector width (must match the configured embedding model — the
# store is dimension-aware; see the multi-model flags above).
# EMBEDDING_DIMENSIONS=

# --- Feature rollout flags (ALL default OFF — enable deliberately) -------------
# Gates for merged-but-dark features. These OVERRIDE the admin-console
# platform flag in BOTH directions and accept ONLY the literal strings
# "true" or "false" — any other value (1, yes, on) is silently IGNORED and
# the admin flag stays in charge. Leave unset to control the flag from
# Admin > Settings > Platform Flags at runtime instead.
# SKILLS_CORE_V2=true         # skill version history, zip package import/export, team/org scoping
# SKILLS_ROUTING_V2=true      # automatic skill selection for chat (advisory ranking)
# SKILLS_RUNTIME_V2=true      # compiled-skill cache, inter-skill deps, version pinning + auto-rollback
# COMMANDS_V1=true            # prompt-template commands via the @ mention picker
# GITHUB_CONNECTOR_V1=true    # GitHub as a first-party MCP-tools connector
# MEMORY_CONTEXT_V2=true      # team memory in chat, unified context budget
# SKILL_IMPORT_V1=true        # Universal Skill Import (Anthropic/OpenAI/CrewAI/Cursor via zip/GitHub/chat)
# Skill lifecycle surfaces (db ≥ 1.5.0 ships their tables; the flags gate the
# UI/behavior only — reads of the columns happen regardless, which is why the
# schema must be migrated even with these off).
# SKILL_GOVERNANCE_V1=true    # policy versioning + attestation surfaces for published skills
# SKILL_QA_V1=true            # skill QA/eval pipeline
# SKILL_PACKAGE_V1=true       # skill packaging/versioned distribution
# SKILL_GENERATOR_V1=true     # AI-assisted skill generation

# --- Observability / alerting --------------------------------------------------
# OTLP traces export when the endpoint is set; service name defaults to neogen.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=neogen
# SENTRY_DSN=
# Error-alert fan-out (generic webhook and/or PagerDuty Events v2).
# ALERT_WEBHOOK_URL=
# PAGERDUTY_ROUTING_KEY=
# Real-user web-vitals: retention sweep of stored samples + ingest rate limit.
# VITALS_RETENTION_ENABLED=true
# VITALS_RETENTION_DAYS=
# VITALS_RATE_LIMIT_PER_MINUTE=
