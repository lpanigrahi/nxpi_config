# Live configuration + backups never leave the VM.
.env
.env.app
# Timestamped ./.env copies taken by upgrade-db.sh before it edits DB_VERSION
# — same live config, same secrecy.
.env.bak-*
# Certificate material (custom-cert mode). The .pfx bundle contains the private
# key and is consumed by generate-certs.sh; the extracted key/cert land in
# certs/, which carries its own .gitignore so only its README is tracked.
*.pfx
backups/*
!backups/.gitkeep
# Written by update.sh during an automatic rollback.
.rollback-image.yml
# Inter-script mutual-exclusion lockfile.
.deploy.lock
