# =============================================================================
# .env.example — Compose INTERPOLATION values for the standalone Azure deploy.
#
# Copy to `.env` (never commit it). Docker Compose auto-loads `.env` from this
# directory and substitutes ${VAR} occurrences in docker-compose.yml. The APP
# container's runtime env comes from ./.env.app; DB/Redis/auth secrets come
# from ./secrets/*.
#
#   cp .env.example .env   # then edit  (./install.sh does this for you)
# =============================================================================

# ── Application image (pulled from the registry — never built on the VM) ─────
# Published by the app repo's CI (github.com/negentrophi/nxpi_dev, ci.yml) on
# every push to main and on v* release tags. Tag vocabulary:
#   latest                     — newest main build (moving)
#   main                       — same as latest (moving)
#   sha-<short>                — immutable, one per commit
#   <pkgver>-main.<shortsha>   — immutable, e.g. 1.2.0-main.80c736af
#   X.Y.Z                      — release tags only (from a v* git tag)
# Pin :X.Y.Z or :sha-<short> for deterministic deploys. ONLY an exact X.Y.Z
# tag participates in DB-version alignment/derivation — every other form is a
# moving/suffixed tag, and DB_VERSION below is authoritative for it.
APP_IMAGE=ghcr.io/negentrophi/nxpi_dev:latest

# Which shipped SQL artifact set to provision from (./db/<version>/). With an
# exact-semver APP_IMAGE tag this may be left unset (auto-derived: :1.2.0 →
# db/1.2.0), but with :latest / :main / :sha-… / a digest — and more than one
# db/* folder shipped — the scripts refuse to guess and install.sh/migrate.sh
# DIE asking for it. Keep it set to the newest shipped folder unless you pin
# APP_IMAGE to an exact semver tag.
DB_VERSION=1.15.0

# Public helper image that computes the admin password hash (Better Auth
# scrypt; contains no application source). Pin to the same version as the app
# for guaranteed hash-format parity.
NXPI_HASH_IMAGE=ghcr.io/negentrophi/nxpi-hash:latest

# ── Ingress mode ─────────────────────────────────────────────────────────────
# IP-only mode (default): leave SITE_ADDRESS unset/empty. Caddy serves plain
# HTTP on :80 at the VM's public IP — no DNS or certificates required.
# Domain mode: set SITE_ADDRESS to a hostname whose DNS A-record points at
# this VM; Caddy then auto-provisions Let's Encrypt TLS on 80/443 (open 443 in
# the NSG) and redirects HTTP→HTTPS.
#SITE_ADDRESS=your-domain.example.com

# Public base URL — Better Auth derives the trusted-origin and auth callbacks
# from THIS var. (Secure cookies are NOT derived from it: NODE_ENV=production
# forces them ON unless you set BETTER_AUTH_COOKIE_SECURE=false in ./.env.app
# — required in IP-only mode, or browsers drop the session cookie over http://
# and sign-in loops.)
#   IP-only mode:  http://<VM_PUBLIC_IP>   (+ BETTER_AUTH_COOKIE_SECURE=false)
#   Domain mode:   https://<SITE_ADDRESS>  (MUST be https with a domain)
BETTER_AUTH_URL=http://<VM_PUBLIC_IP>

# Custom-certificate mode (bring your own cert instead of Let's Encrypt —
# corporate CA, wildcard, or a VM the ACME servers cannot reach): put the
# certificate .pfx at the project root and run ./install.sh (it auto-detects
# and extracts it — see certs/README.md). Requires SITE_ADDRESS set to the
# certificate's hostname. PFX_PASSWORD is the bundle's export password for
# non-interactive extraction (quote it if it contains spaces or '#'; safe to
# remove once certs are generated). TLS_CERT_PATH/TLS_KEY_PATH only override
# the default container paths /certs/fullchain.crt + /certs/server.key.
#PFX_PASSWORD=
#TLS_CERT_PATH=/certs/fullchain.crt
#TLS_KEY_PATH=/certs/server.key

# Host ports Caddy publishes. Leave at defaults on the VM; override only when
# smoke-testing the package on a workstation where 80/443 are taken.
#CADDY_HTTP_PORT=80
#CADDY_HTTPS_PORT=443

# ── First-run provisioning (read by ./install.sh at the seed step) ───────────
# Super admin created on a fresh database. SET SUPER_ADMIN_EMAIL to your own
# address BEFORE the first ./install.sh. Leave SUPER_ADMIN_PASSWORD unset
# (commented) to have install.sh GENERATE a strong password and print it ONCE
# — capture it. A re-run never re-seeds or resets the password.
# NOTE: only these TWO values are configurable. The admin display name and the
# default organization name/slug are fixed by the static seed
# (db/<version>/seed.sql) — change them in the app UI after first login.
SUPER_ADMIN_EMAIL=admin@negentrophi.com
# A password containing spaces or a '#' MUST be quoted, e.g.
#   SUPER_ADMIN_PASSWORD="p @ss #1"
# (unquoted, an inline ` #…` is treated as a comment and stripped — dotenv rule).
#SUPER_ADMIN_PASSWORD=

# ── Browser automation sidecar (optional; used with `--profile browser`) ─────
# BOTH values belong HERE (Compose interpolation), NOT in ./.env.app — the app
# service's `environment:` entry for BROWSER_WS_ENDPOINT is interpolated from
# this file and overrides anything set via env_file. The endpoint's token must
# equal BROWSER_TOKEN. See .env.app.example for the matching
# ALLOW_BROWSER_AUTOMATION switch and the enable steps.
#BROWSER_TOKEN=
#BROWSER_WS_ENDPOINT=ws://browser:3000?token=<BROWSER_TOKEN>

# ── Compose project name (advanced) ──────────────────────────────────────────
# Defaults to `neogen` (the `name:` key in docker-compose.yml). Volume names
# derive from it (neogen_postgres-data, neogen_uploads-data, …) and the
# scripts' adoption guard and backup/restore target volumes BY that name —
# override only if you know why, and never on an existing deployment.
#COMPOSE_PROJECT_NAME=neogen

# ── Operations ───────────────────────────────────────────────────────────────
# Days of local backups kept by ./backup.sh (older ones are pruned).
#BACKUP_RETENTION_DAYS=7

# ── Tools ────────────────────────────────────────────────────────────────────
# Exa AI for web search and content extraction (optional, but recommended for
# @web and research features).
#EXA_API_KEY=

# ── Resource profile ─────────────────────────────────────────────────────────
# Interpolated so ONE compose file is valid on both the current 8 GB VM and a
# larger replacement. The DEFAULTS below fit 8 GB and are what you get if you
# set nothing; the app repo's `scripts/azure-compose.test.ts` asserts they still
# sum under it.
# Compose limits are CEILINGS, not reservations — oversubscribing "works" until
# real load, then the kernel OOM killer picks a victim. Raise these only after
# the VM actually has the memory.
#
# 16 GB profile (Standard_D4ds_v6), for reference:
#   PG_MEM_LIMIT=8g   APP_MEM_LIMIT=4g   REDIS_CACHE_MEM_LIMIT=1g
#   POSTGRES_SHARED_BUFFERS=2GB   POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
#   POSTGRES_MAINTENANCE_WORK_MEM=2GB   POSTGRES_PARALLEL_MAINTENANCE=4
#   POSTGRES_WORK_MEM=32MB   POSTGRES_MAX_WAL_SIZE=8GB
# PG_MEM_LIMIT=512m
# APP_MEM_LIMIT=1g
# REDIS_MEM_LIMIT=256m
# REDIS_CACHE_MEM_LIMIT=256m
# REDIS_CACHE_MAXMEMORY=192mb
#
# pgvector tuning. shared_buffers must stay well inside PG_MEM_LIMIT — under
# cgroup v2 the limit bounds shared_buffers AND the page cache together, and
# the HNSW graph lives in that same budget.
# POSTGRES_SHARED_BUFFERS=128MB
# POSTGRES_EFFECTIVE_CACHE_SIZE=384MB
# POSTGRES_MAINTENANCE_WORK_MEM=128MB
# POSTGRES_PARALLEL_MAINTENANCE=2
# POSTGRES_WORK_MEM=8MB
# POSTGRES_MAX_WAL_SIZE=2GB

# ── Backups ──────────────────────────────────────────────────────────────────
# Retention is age-based (BACKUP_RETENTION_DAYS, above) with a COUNT floor:
# `find -mtime` alone deletes your last dump after a quiet month. The floor
# keeps the newest N of EACH artifact kind — a backup is the dump AND the
# uploads archive taken with it, and keeping one without the other leaves
# restore.sh --uploads nothing to pair with the dump it is handed.
# BACKUP_MIN_KEEP=3
#
# Automated off-VM shipping. A single VM's disk is not a durability story —
# losing the machine loses the database AND every dump beside it. Set BOTH to
# enable; backup.sh then exits nonzero if shipping fails, so cron notices.
# Uses --auth-mode login (the VM's managed identity), so no account key on disk.
# Give the container versioning + an immutability policy: a backup a compromised
# VM can delete is not a backup.
# BACKUP_BLOB_ACCOUNT=
# BACKUP_BLOB_CONTAINER=backups

# ── Point-in-time recovery (pgBackRest) — OFF by default ─────────────────────
# backup.sh (pg_dump) keeps working unchanged; this adds a WAL archive so you
# can recover to a POINT IN TIME rather than to the last dump.
#
# Order matters. Enabling archive_mode while the repository is unreachable makes
# Postgres RETAIN every WAL segment until the disk fills and writes stop:
#   1. POSTGRES_IMAGE=ghcr.io/<owner>/nxpi-postgres:<ver>   (carries pgbackrest;
#      archive_command runs inside the postgres container, so a sidecar cannot
#      supply it). Then: ./compose.sh up -d postgres
#   2. fill repo1-azure-* in ./pgbackrest.conf
#   3. ./pgbackrest.sh stanza-create
#   4. ./pgbackrest.sh check      ← MUST pass before step 5
#   5. POSTGRES_ARCHIVE_MODE=on, then RESTART postgres (archive_mode needs a
#      restart, not a reload): ./compose.sh up -d --force-recreate postgres
#
# POSTGRES_IMAGE=
# POSTGRES_ARCHIVE_MODE=off
# POSTGRES_ARCHIVE_TIMEOUT=60
# PGBACKREST_STANZA=neogen
#
# Secrets never go in pgbackrest.conf (it is committed). pgbackrest reads
# PGBACKREST_* from the environment and they override the file — prefer a
# managed identity over a shared key.
# PGBACKREST_REPO1_AZURE_KEY=
